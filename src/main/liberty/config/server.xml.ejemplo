<?xml version="1.0" encoding="UTF-8"?>
<!-- Copiar a server.xml y configurar .env; ver docs/LEVANTAR.md. Sin secretos. -->
<server description="Servidor Open Liberty para GalenoSV">
    <featureManager>
        <feature>jakartaee-11.0</feature>
    </featureManager>

    <variable name="HTTP_PORT" defaultValue="9080" />
    <variable name="HTTPS_PORT" defaultValue="9443" />
    <variable name="HTTP_HOST" defaultValue="localhost" />
    <ltpa keysPassword="${env.LTPA_KEYS_PASSWORD}" />
    <httpSession cookieSameSite="Lax" useContextRootAsCookiePath="true" />
    <httpEndpoint host="${HTTP_HOST}" httpPort="${HTTP_PORT}" httpsPort="${HTTPS_PORT}" id="defaultHttpEndpoint" />

    <dataSource id="postgresDS" jndiName="jdbc/postgres">
        <jdbcDriver libraryRef="PostgreSQL-Library" />
        <properties.postgresql databaseName="${env.PG_DB}"
                               serverName="${env.PG_HOST}"
                               portNumber="${env.PG_PORT}"
                               user="${env.PG_USER}"
                               password="${env.PG_PASS}" />
    </dataSource>

    <library id="PostgreSQL-Library">
        <fileset dir="${server.config.dir}/lib/global" includes="postgresql-*.jar" />
    </library>
</server>
