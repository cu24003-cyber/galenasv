              xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-facesconfig_4_1.xsd"
              version="4.1">
    <application>
        <locale-config>
            <default-locale>es</default-locale>
            <supported-locale>en</supported-locale>
            <supported-locale>fr</supported-locale>
            <supported-locale>pt</supported-locale>
            <supported-locale>zh</supported-locale>
        </locale-config>
        <resource-bundle>
            <base-name>i18n.Messages</base-name>
            <var>msg</var>
        </resource-bundle>
    </application>
    <converter>
        <converter-id>tipoDocumentoConverter</converter-id>
        <converter-class>sv.edu.ues.ingenieria.ppi115_2026.salud.galenosv.converter.TipoDocumentoConverter</converter-class>
    </converter>
    <converter>
        <converter-id>tipoMedioContactoConverter</converter-id>
        <converter-class>sv.edu.ues.ingenieria.ppi115_2026.salud.galenosv.converter.TipoMedioContactoConverter</converter-class>
    </converter>
</faces-config>
